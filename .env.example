# Copy to .env and fill in. Never commit .env.

# --- security ---
# "development" lets the API run without a token (local use only). Anything else requires API_AUTH_TOKEN.
ENVIRONMENT=production
# Shared secret for the API and the web login. Generate: openssl rand -hex 32
API_AUTH_TOKEN=
# Allowed browser origins for the API, comma separated
CORS_ORIGINS=http://localhost:3000
# "celery" (worker + Redis) or "inline" (runs inside the API process, fine for local dev)
TASK_BACKEND=celery

POSTGRES_USER=docintel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=docintel

DATABASE_URL=postgresql://docintel:change-me@postgres:5432/docintel
REDIS_URL=redis://redis:6379/0
LLM_API_KEY=
UPLOAD_DIR=/data/uploads
MAX_FILE_SIZE_MB=200
EMBEDDING_DIMENSION=1536
OCR_LANGUAGES=eng+ben
# anthropic, or "demo" (rule-based stand-in, no API key needed)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=high
LLM_CONCURRENCY=4
